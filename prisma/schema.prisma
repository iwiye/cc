generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREATOR
  SUBSCRIBER
}

enum ContentType {
  PHOTO
  VIDEO
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum SubscriptionPlan {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TransactionType {
  SUBSCRIPTION
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  MTN
  ORANGE
  AIRTEL
  MOOV
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  password      String
  role          Role      @default(SUBSCRIBER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creatorProfile    CreatorProfile?
  subscriberProfile SubscriberProfile?
  transactions      Transaction[]

  @@map("users")
}

model CreatorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  artistName         String
  bio                String?
  avatar             String?
  coverImage         String?
  isVerified         Boolean  @default(false)
  kycDocument        String?
  kycStatus          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  weeklyPrice        Int      @default(1000)  // Prix en FCFA
  monthlyPrice       Int      @default(3000)
  quarterlyPrice     Int      @default(7500)
  totalEarnings      Int      @default(0)
  availableBalance   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contents      Content[]
  subscriptions Subscription[] @relation("CreatorSubscriptions")
  withdrawals   Withdrawal[]

  @@map("creator_profiles")
}

model SubscriberProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[] @relation("SubscriberSubscriptions")

  @@map("subscriber_profiles")
}

model Content {
  id          String        @id @default(cuid())
  creatorId   String
  type        ContentType
  url         String
  thumbnail   String?
  title       String?
  description String?
  isPreview   Boolean       @default(false) // Contenu gratuit/preview
  status      ContentStatus @default(DRAFT)
  views       Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([status])
  @@map("contents")
}

model Subscription {
  id            String             @id @default(cuid())
  subscriberId  String
  creatorId     String
  plan          SubscriptionPlan
  status        SubscriptionStatus @default(ACTIVE)
  amount        Int
  startDate     DateTime           @default(now())
  endDate       DateTime
  transactionId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  subscriber SubscriberProfile @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    CreatorProfile    @relation("CreatorSubscriptions", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, creatorId])
  @@index([subscriberId])
  @@index([creatorId])
  @@index([status])
  @@map("subscriptions")
}

model Transaction {
  id        String            @id @default(cuid())
  userId    String
  amount    Int
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  provider  PaymentProvider?
  reference String            @unique
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([reference])
  @@map("transactions")
}

model Withdrawal {
  id           String           @id @default(cuid())
  creatorId    String
  amount       Int
  status       WithdrawalStatus @default(PENDING)
  phoneNumber  String
  provider     PaymentProvider
  reference    String?
  requestedAt  DateTime         @default(now())
  processedAt  DateTime?
  processedBy  String?
  rejectReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([status])
  @@map("withdrawals")
}
